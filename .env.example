# Copy to .env for development. Never upload .env to GitHub.
NODE_ENV=development
PORT=3000
# Canonical browser URL. Local loopback requests also support localhost/127.0.0.1 and Vite's actual port.
APP_ORIGIN=http://localhost:5173
# Supabase Connect > Transaction pooler, port 6543, IPv4 compatible.
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_URL_ENCODED_PASSWORD@REPLACE_POOLER_HOST:6543/postgres
DATABASE_SCHEMA=lumina
DATABASE_SSL=true
DATABASE_POOL_MAX=2
# If certificate validation fails: paste trusted Supabase CA PEM here (literal \n allowed).
DATABASE_CA_PEM=
DATABASE_CA_FILE=
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
# Server-only secret key (sb_secret_...) or legacy service_role, NOT anon/publishable.
SUPABASE_STORAGE_KEY=REPLACE_SERVER_ONLY_STORAGE_KEY
SUPABASE_BUCKET=lumina-private
# production deployment MUST use false. For isolated local demo: true + custom password.
DEMO_MODE=false
DEMO_PASSWORD=
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000
SHOP_SUPPORT_EMAIL=
SHOP_SUPPORT_PHONE=
INIT_ADMIN_EMAIL=REPLACE_WITH_YOUR_EMAIL
INIT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_12_CHARS
# Locally only, password of the least-privilege database runtime role.
INIT_RUNTIME_PASSWORD=REPLACE_WITH_STRONG_RUNTIME_PASSWORD_16_CHARS
# Used only when running locally without Supabase storage.
UPLOADS_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
