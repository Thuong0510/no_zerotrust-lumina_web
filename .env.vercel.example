# Configure these in Vercel > Settings > Environment Variables > Production.
# This template is documentation, NOT a file to upload as real credentials.
NODE_ENV=production
APP_ORIGIN=https://YOUR_PROJECT.vercel.app
DATABASE_URL=postgresql://lumina_app.REPLACE_PROJECT_REF:REPLACE_URL_ENCODED_PASSWORD@REPLACE_POOLER_HOST:6543/postgres
DATABASE_SCHEMA=lumina
DATABASE_SSL=true
DATABASE_POOL_MAX=2
DATABASE_CA_PEM=
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_STORAGE_KEY=REPLACE_SERVER_ONLY_STORAGE_KEY
SUPABASE_BUCKET=lumina-private
DEMO_MODE=false
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000
SHOP_SUPPORT_EMAIL=
SHOP_SUPPORT_PHONE=
# No INIT_ADMIN_PASSWORD, DEMO_PASSWORD, or migration/admin connection on Vercel.
# SMTP_* optional, same names as .env.example.
