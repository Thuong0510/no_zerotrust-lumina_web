{
  "name": "lumina-mvc-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch --import tsx backend/src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "start": "node --env-file=.env --import tsx backend/src/server.ts",
    "db:migrate": "node --env-file=.env --import tsx backend/scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx backend/scripts/seed.ts",
    "db:role": "node --env-file=.env --import tsx backend/scripts/runtime-role.ts",
    "db:seed:fashion": "node --env-file=.env --import tsx backend/scripts/seed-fashion-demo.ts",
    "db:import": "node --env-file=.env --import tsx backend/scripts/import-sqlite.ts",
    "test:embedded": "npm run build && node --import tsx tests/embedded.ts",
    "test:integration": "node --import tsx tests/embedded.ts integration",
    "test:checkout": "node --import tsx tests/embedded.ts checkout",
    "test:accounts": "node --import tsx tests/embedded.ts accounts",
    "test:security": "node --import tsx tests/embedded.ts security",
    "test:owasp": "node --import tsx tests/embedded.ts owasp",
    "test:owasp-registration": "node --import tsx tests/embedded.ts owasp-registration",
    "test:production": "node --import tsx tests/embedded.ts production",
    "test:role": "node --import tsx tests/embedded.ts role",
    "test:shopping": "node --import tsx tests/shopping.tsx",
    "test:storefront": "node --import tsx tests/storefront.tsx",
    "test:navigation": "node --import tsx tests/navigation.tsx",
    "test:request-url": "node --import tsx tests/request-url.ts",
    "test:accounts-ui": "node --import tsx tests/accounts-ui.tsx",
    "test:seed:fashion": "node --import tsx tests/fashion-demo.ts",
    "test:api-routing": "node --import tsx tests/api-routing.ts",
    "test": "npm run test:embedded && npm run test:shopping && npm run test:storefront && npm run test:navigation && npm run test:request-url && npm run test:accounts-ui && npm run test:api-routing && npm run test:seed:fashion"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/functions": "^3.9.11",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.55.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
